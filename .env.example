# Copier en .env et remplacer les valeurs. Ne jamais versionner le .env.

# PostgreSQL
POSTGRES_USER=ramdam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ramdam
DATABASE_URL=postgresql://ramdam:change-me@localhost:5432/ramdam

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# MinIO (stockage des images)
MINIO_ROOT_USER=ramdam
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# API
PORT=3000

# Authentification : clé de signature des JWT (au moins 32 caractères aléatoires,
# générer avec `openssl rand -base64 48`) et durée de validité en secondes.
JWT_SECRET=change-me
JWT_DUREE_SECONDES=3600

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules)
CORS_ORIGINES=http://localhost:8081
