# Copier en .env et remplacer les valeurs. Ne jamais versionner le .env.

# PostgreSQL
POSTGRES_USER=ramdam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ramdam
DATABASE_URL=postgresql://ramdam:change-me@localhost:5432/ramdam

# Redis
